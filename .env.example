# Copy to `.env` next to docker-compose.local.yml and edit for your network.
# Compose reads that file automatically for ${...} substitution, so the values
# below survive a plain `docker compose up` rather than having to be passed on
# the command line every time.
#
#   cp .env.example .env

# Subnets the container may reach WITHOUT going through the VPN tunnel.
#
# Set this to your own LAN. It is what makes anything on the local network
# reachable from behind gluetun - the research corpus below, a NAS share, a
# local Ollama. Note the name: `NET_LOCAL` is NOT a gluetun setting, and using
# it leaves every LAN address unreachable while looking configured.
LAN_SUBNET=192.168.1.0/24

# A library service that can say which search results you already hold, so the
# UI marks them before you download a second copy. Leave empty to turn the
# feature off - the results simply appear unannotated.
#
# Use the host's LAN address. NOT localhost, which inside this container is
# gluetun's, since the app shares its network namespace; and NOT
# host.docker.internal, because Docker refuses extra_hosts alongside
# `network_mode: service:`, so that name cannot be mapped here.
LIBGEN_CORPUS_URL=http://192.168.1.50:8000

# Contact address for Unpaywall's open-access lookup (sent only to Unpaywall).
# Empty turns the open-access source off.
LIBGEN_OPEN_ACCESS_EMAIL=

# Anna's Archive member secret key, for its fast download API. Empty turns the
# fallback off. Keep it here in .env; never commit it.
ANNAS_ARCHIVE_KEY=
# LIBGEN_ANNAS_DOMAIN=annas-archive.gl

# Wiley text-and-data-mining token, for Wiley's open-access PDFs. Empty turns
# it off. Keep it here in .env; never commit it.
WILEY_TDM_TOKEN=

# A library EZproxy prefix, e.g. https://<library>.idm.oclc.org/login?url=,
# for an "Open via library" link on rows that could not be fetched. Empty
# hides the link. It is only ever a link for a person to click.
LIBGEN_LIBRARY_PROXY=
